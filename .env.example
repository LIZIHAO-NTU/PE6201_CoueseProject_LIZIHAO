# Copy this file to .env. Never commit the real key.
OPENROUTER_API_KEY=replace-with-your-course-key
SCAMLENS_SECRET_KEY=replace-with-a-random-local-secret

# Optional controls
SCAMLENS_LLM_MODEL=google/gemini-2.5-flash
SCAMLENS_LLM_MAX_OUTPUT_TOKENS=400
SCAMLENS_LLM_TIMEOUT_SECONDS=15
SCAMLENS_LLM_BUDGET_USD=8.0
SCAMLENS_ALLOW_DEV_MODE=1
SCAMLENS_BENCHMARK_MAX_CASES=30
SCAMLENS_BENCHMARK_MAX_BUDGET_USD=2.0

# Optional local paths. Defaults already keep SQLite private and exports reproducible.
# SCAMLENS_EVALUATION_DB=instance/scamlens_evaluation.sqlite3
# SCAMLENS_EVALUATION_EXPORT_DIR=outputs/evaluation/persistent

# Cost estimates used only when OpenRouter does not return a cost.
SCAMLENS_LLM_INPUT_COST_PER_MILLION=0.30
SCAMLENS_LLM_OUTPUT_COST_PER_MILLION=2.50
